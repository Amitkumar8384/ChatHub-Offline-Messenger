import React, { useState } from 'react';
import {
  SafeAreaView,
  StatusBar,
  StyleSheet,
  Text,
  View,
  ScrollView,
  TextInput,
  TouchableOpacity,
  Platform,
} from 'react-native';

const COLORS = {
  background: '#090D18',
  surface: '#111827',
  card: '#151E30',
  border: '#253149',
  primary: '#6C8CFF',
  text: '#F4F7FF',
  muted: '#8C9AB5',
  green: '#36D6A0',
  purple: '#B29AFF',
};

const initialChats = [
  {
    id: '1',
    name: 'Alex Morgan',
    initials: 'AM',
    message: 'Hey! Are you nearby?',
    time: '10:42',
    color: '#304B77',
    unread: 2,
    online: true,
  },
  {
    id: '2',
    name: 'Sarah Wilson',
    initials: 'SW',
    message: 'Photo received successfully',
    time: '09:18',
    color: '#654A80',
    unread: 0,
    online: false,
  },
  {
    id: '3',
    name: 'Daniel Carter',
    initials: 'DC',
    message: 'Can you send that PDF?',
    time: 'Yesterday',
    color: '#386B64',
    unread: 0,
    online: true,
  },
];

const initialRequests = [
  {
    id: 'r1',
    name: 'Jordan Lee',
    initials: 'JL',
    detail: 'Wants to connect with you',
    color: '#7558A6',
  },
];

function Avatar({ initials, color, size = 52, online = false }) {
  return (
    <View
      style={[
        styles.avatar,
        {
          width: size,
          height: size,
          borderRadius: size / 3,
          backgroundColor: color,
        },
      ]}
    >
      <Text style={[styles.avatarText, { fontSize: size * 0.29 }]}>
        {initials}
      </Text>

      {online && <View style={styles.onlineDot} />}
    </View>
  );
}

function SectionTitle({ title, action, onPress }) {
  return (
    <View style={styles.sectionHeader}>
      <Text style={styles.sectionTitle}>{title}</Text>

      {action && (
        <TouchableOpacity onPress={onPress} activeOpacity={0.7}>
          <Text style={styles.sectionAction}>{action}</Text>
        </TouchableOpacity>
      )}
    </View>
  );
}

export default function App() {
  const [activeTab, setActiveTab] = useState('Home');
  const [search, setSearch] = useState('');
  const [chats, setChats] = useState(initialChats);
  const [requests, setRequests] = useState(initialRequests);
  const [notice, setNotice] = useState('');

  const filteredChats = chats.filter((chat) =>
    chat.name.toLowerCase().includes(search.toLowerCase())
  );

  const showNotice = (message) => {
    setNotice(message);
  };

  const handleRequest = (id, accepted) => {
    const request = requests.find((item) => item.id === id);

    setRequests((previous) => previous.filter((item) => item.id !== id));

    if (accepted && request) {
      setChats((previous) => [
        {
          id: `chat-${Date.now()}`,
          name: request.name,
          initials: request.initials,
          message: 'You are now connected',
          time: 'Now',
          color: request.color,
          unread: 0,
          online: false,
        },
        ...previous,
      ]);

      showNotice(`${request.name} added to your chats`);
    } else {
      showNotice('Connection request declined');
    }
  };

  const openTab = (tab) => {
    setActiveTab(tab);
    setNotice('');
  };

  const renderHome = () => (
    <>
      <View style={styles.welcomeRow}>
        <View style={styles.welcomeText}>
          <Text style={styles.eyebrow}>YOUR PRIVATE SPACE</Text>
          <Text style={styles.heading}>Stay connected.</Text>
          <Text style={styles.subtitle}>
            Chat directly. Share freely.
          </Text>
        </View>

        <TouchableOpacity
          style={styles.profileButton}
          onPress={() => openTab('Profile')}
          accessibilityLabel="Open profile"
        >
          <Text style={styles.profileInitial}>A</Text>
          <View style={styles.profileOnline} />
        </TouchableOpacity>
      </View>

      <View style={styles.connectionBanner}>
        <View style={styles.bannerIcon}>
          <Text style={styles.bannerIconText}>⌁</Text>
        </View>

        <View style={styles.bannerContent}>
          <Text style={styles.bannerTitle}>Ready to connect?</Text>
          <Text style={styles.bannerDescription}>
            Find nearby ChatHub devices.
          </Text>
        </View>

        <View style={styles.statusPill}>
          <View style={styles.statusDot} />
          <Text style={styles.statusText}>Ready</Text>
        </View>
      </View>

      <SectionTitle
        title="Quick actions"
      />

      <View style={styles.actionRow}>
        <TouchableOpacity
          style={styles.actionCard}
          onPress={() => openTab('Nearby')}
          activeOpacity={0.8}
        >
          <View style={[styles.actionIcon, { backgroundColor: '#24365D' }]}>
            <Text style={styles.actionEmoji}>⌕</Text>
          </View>
          <Text style={styles.actionTitle}>Find nearby</Text>
          <Text style={styles.actionSubtitle}>Discover devices</Text>
          <Text style={styles.actionArrow}>↗</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.actionCard}
          onPress={() => openTab('Requests')}
          activeOpacity={0.8}
        >
          <View style={[styles.actionIcon, { backgroundColor: '#352B57' }]}>
            <Text style={styles.actionEmoji}>♧</Text>
          </View>
          <Text style={styles.actionTitle}>Requests</Text>
          <Text style={styles.actionSubtitle}>Manage invites</Text>
          {requests.length > 0 && (
            <View style={styles.actionBadge}>
              <Text style={styles.actionBadgeText}>{requests.length}</Text>
            </View>
          )}
          <Text style={styles.actionArrow}>↗</Text>
        </TouchableOpacity>
      </View>

      <SectionTitle
        title="Connection requests"
        action="View all"
        onPress={() => openTab('Requests')}
      />

      {requests.length === 0 ? (
        <View style={styles.emptyInline}>
          <Text style={styles.emptyText}>No pending requests.</Text>
        </View>
      ) : (
        requests.slice(0, 2).map((request) => (
          <View style={styles.requestCard} key={request.id}>
            <Avatar
              initials={request.initials}
              color={request.color}
              size={48}
            />

            <View style={styles.requestInfo}>
              <Text style={styles.personName}>{request.name}</Text>
              <Text style={styles.personDetail}>{request.detail}</Text>
            </View>

            <TouchableOpacity
              style={styles.acceptButton}
              onPress={() => handleRequest(request.id, true)}
            >
              <Text style={styles.acceptText}>✓</Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={styles.declineButton}
              onPress={() => handleRequest(request.id, false)}
            >
              <Text style={styles.declineText}>×</Text>
            </TouchableOpacity>
          </View>
        ))
      )}

      <SectionTitle
        title="Recent chats"
        action="See all"
        onPress={() => openTab('Chats')}
      />

      {filteredChats.length === 0 ? (
        <View style={styles.emptyInline}>
          <Text style={styles.emptyText}>No chats match your search.</Text>
        </View>
      ) : (
        filteredChats.slice(0, 3).map(renderChatRow)
      )}

      <View style={styles.privacyNote}>
        <Text style={styles.privacyIcon}>◇</Text>
        <View style={styles.privacyContent}>
          <Text style={styles.privacyTitle}>Your conversations, your space</Text>
          <Text style={styles.privacyDescription}>
            ChatHub is being built for direct device-to-device communication.
          </Text>
        </View>
      </View>
    </>
  );

  function renderChatRow(chat) {
    return (
      <TouchableOpacity
        key={chat.id}
        style={styles.chatRow}
        activeOpacity={0.75}
        onPress={() => showNotice(`Chat with ${chat.name} is not connected yet`)}
      >
        <Avatar
          initials={chat.initials}
          color={chat.color}
          online={chat.online}
          size={51}
        />

        <View style={styles.chatContent}>
          <Text style={styles.personName}>{chat.name}</Text>
          <Text style={styles.chatMessage} numberOfLines={1}>
            {chat.message}
          </Text>
        </View>

        <View style={styles.chatMeta}>
          <Text style={styles.chatTime}>{chat.time}</Text>
          {chat.unread > 0 && (
            <View style={styles.unreadBadge}>
              <Text style={styles.unreadText}>{chat.unread}</Text>
            </View>
          )}
        </View>
      </TouchableOpacity>
    );
  }

  const renderNearby = () => (
    <View style={styles.pageContent}>
      <Text style={styles.eyebrow}>DISCOVER</Text>
      <Text style={styles.pageHeading}>Nearby devices</Text>
      <Text style={styles.subtitle}>
        Find people around you using ChatHub.
      </Text>

      <View style={styles.scannerCard}>
        <View style={styles.scannerCircle}>
          <Text style={styles.scannerSymbol}>⌁</Text>
        </View>
        <Text style={styles.scannerTitle}>Nearby discovery</Text>
        <Text style={styles.scannerDescription}>
          Native device discovery has not been connected yet.
        </Text>

        <TouchableOpacity
          style={styles.primaryButton}
          onPress={() =>
            showNotice(
              'Discovery will work after Nearby Connections is integrated.'
            )
          }
        >
          <Text style={styles.primaryButtonText}>Prepare discovery</Text>
        </TouchableOpacity>
      </View>

      <View style={styles.infoCard}>
        <Text style={styles.infoTitle}>How it will work</Text>
        <Text style={styles.infoLine}>01  Enable nearby permissions</Text>
        <Text style={styles.infoLine}>02  Discover active ChatHub devices</Text>
        <Text style={styles.infoLine}>03  Send a connection request</Text>
        <Text style={styles.infoLine}>04  Connect after acceptance</Text>
      </View>
    </View>
  );

  const renderRequests = () => (
    <View style={styles.pageContent}>
      <Text style={styles.eyebrow}>CONNECTIONS</Text>
      <Text style={styles.pageHeading}>Requests</Text>
      <Text style={styles.subtitle}>
        Decide who you want to connect with.
      </Text>

      {requests.length === 0 ? (
        <View style={styles.emptyCard}>
          <Text style={styles.emptyIcon}>♧</Text>
          <Text style={styles.emptyTitle}>All caught up</Text>
          <Text style={styles.emptyText}>No pending connection requests.</Text>
        </View>
      ) : (
        requests.map((request) => (
          <View style={styles.requestPageCard} key={request.id}>
            <Avatar initials={request.initials} color={request.color} />
            <View style={styles.requestInfo}>
              <Text style={styles.personName}>{request.name}</Text>
              <Text style={styles.personDetail}>{request.detail}</Text>
              <View style={styles.requestActions}>
                <TouchableOpacity
                  style={styles.acceptLarge}
                  onPress={() => handleRequest(request.id, true)}
                >
                  <Text style={styles.acceptLargeText}>Accept</Text>
                </TouchableOpacity>
                <TouchableOpacity
                  style={styles.declineLarge}
                  onPress={() => handleRequest(request.id, false)}
                >
                  <Text style={styles.declineLargeText}>Decline</Text>
                </TouchableOpacity>
              </View>
            </View>
          </View>
        ))
      )}
    </View>
  );

  const renderChats = () => (
    <View style={styles.pageContent}>
      <Text style={styles.eyebrow}>MESSAGES</Text>
      <Text style={styles.pageHeading}>Your chats</Text>
      <Text style={styles.subtitle}>Your recent conversations.</Text>

      <View style={styles.searchBox}>
        <Text style={styles.searchIcon}>⌕</Text>
        <TextInput
          value={search}
          onChangeText={setSearch}
          placeholder="Search conversations..."
          placeholderTextColor={COLORS.muted}
          style={styles.searchInput}
        />
      </View>

      {filteredChats.map(renderChatRow)}
    </View>
  );

  const renderProfile = () => (
    <View style={styles.pageContent}>
      <Text style={styles.eyebrow}>ACCOUNT</Text>
      <Text style={styles.pageHeading}>Your profile</Text>

      <View style={styles.profileCard}>
        <View style={styles.largeProfile}>
          <Text style={styles.largeProfileText}>A</Text>
        </View>
        <Text style={styles.profileName}>ChatHub User</Text>
        <Text style={styles.profileDescription}>Personal device profile</Text>
        <View style={styles.profileStatus}>
          <View style={styles.statusDot} />
          <Text style={styles.profileStatusText}>Ready to connect</Text>
        </View>
      </View>

      <View style={styles.infoCard}>
        <Text style={styles.infoTitle}>App information</Text>
        <Text style={styles.infoLine}>App: ChatHub</Text>
        <Text style={styles.infoLine}>Mode: Offline-first</Text>
        <Text style={styles.infoLine}>Account: Local profile</Text>
      </View>

      <Text style={styles.profileFootnote}>
        Profile editing and secure identity setup will be added in a later step.
      </Text>
    </View>
  );

  const renderCurrentPage = () => {
    switch (activeTab) {
      case 'Nearby':
        return renderNearby();
      case 'Requests':
        return renderRequests();
      case 'Chats':
        return renderChats();
      case 'Profile':
        return renderProfile();
      default:
        return renderHome();
    }
  };

  const tabs = [
    { label: 'Home', icon: '⌂' },
    { label: 'Nearby', icon: '⌕' },
    { label: 'Chats', icon: '▤' },
    { label: 'Requests', icon: '♧' },
    { label: 'Profile', icon: '○' },
  ];

  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar style="light" backgroundColor={COLORS.background} />

      <View style={styles.appContainer}>
        <View style={styles.topBar}>
          <TouchableOpacity
            style={styles.brand}
            onPress={() => openTab('Home')}
          >
            <View style={styles.brandMark}>
              <Text style={styles.brandMarkText}>C</Text>
            </View>
            <Text style={styles.brandName}>
              Chat<Text style={styles.brandAccent}>Hub</Text>
            </Text>
          </TouchableOpacity>

          <View style={styles.topBarRight}>
            <View style={styles.encryptedBadge}>
              <Text style={styles.encryptedIcon}>◇</Text>
              <Text style={styles.encryptedText}>PRIVATE</Text>
            </View>
          </View>
        </View>

        <View style={styles.searchBox}>
          <Text style={styles.searchIcon}>⌕</Text>
          <TextInput
            value={search}
            onChangeText={setSearch}
            placeholder="Search chats..."
            placeholderTextColor={COLORS.muted}
            style={styles.searchInput}
            returnKeyType="search"
          />
          {search.length > 0 && (
            <TouchableOpacity onPress={() => setSearch('')}>
              <Text style={styles.clearSearch}>×</Text>
            </TouchableOpacity>
          )}
        </View>

        {notice ? (
          <TouchableOpacity
            style={styles.notice}
            onPress={() => setNotice('')}
            activeOpacity={0.8}
          >
            <Text style={styles.noticeText}>{notice}</Text>
            <Text style={styles.noticeClose}>×</Text>
          </TouchableOpacity>
        ) : null}

        <ScrollView
          style={styles.scrollView}
          contentContainerStyle={styles.scrollContent}
          showsVerticalScrollIndicator={false}
          keyboardShouldPersistTaps="handled"
        >
          {renderCurrentPage()}
          <View style={styles.bottomSpacer} />
        </ScrollView>

        <View style={styles.bottomNav}>
          {tabs.map((tab) => {
            const active = activeTab === tab.label;

            return (
              <TouchableOpacity
                key={tab.label}
                style={styles.navItem}
                onPress={() => openTab(tab.label)}
                activeOpacity={0.7}
              >
                <View style={[styles.navIconBox, active && styles.navIconActive]}>
                  <Text
                    style={[
                      styles.navIcon,
                      active && styles.navIconSelected,
                    ]}
                  >
                    {tab.icon}
                  </Text>
                  {tab.label === 'Requests' && requests.length > 0 && (
                    <View style={styles.navBadge} />
                  )}
                </View>
                <Text style={[styles.navLabel, active && styles.navLabelActive]}>
                  {tab.label}
                </Text>
              </TouchableOpacity>
            );
          })}
        </View>
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  safeArea: {
    flex: 1,
    backgroundColor: COLORS.background,
    paddingTop: Platform.OS === 'android' ? 0 : 0,
  },
  appContainer: {
    flex: 1,
    backgroundColor: COLORS.background,
  },
  topBar: {
    height: 65,
    paddingHorizontal: 21,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'space-between',
    borderBottomWidth: 1,
    borderBottomColor: '#182237',
  },
